PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tripai?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Google Cloud OAuth Web application client ID (same value as frontend REACT_APP_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# OpenAI API Key for AI Admin Assistant
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Razorpay Test Mode only. Get test keys from the Razorpay Dashboard.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Google Gemini API Key for Traveler Itinerary Planning (optional, Wikivoyage fallback is active)
GEMINI_API_KEY=

# Optional self-hosted OSRM server. Defaults to the public OSRM demo server.
# OSRM_API_URL=https://router.project-osrm.org

# SMTP Email Settings for OTP Login and Trip PDF confirmations
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

ADMIN_EMAIL=admin@tripai.com
ADMIN_PASSWORD=TripAI@Admin2026
